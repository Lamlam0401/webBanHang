<div class="mt-4 container">
    <h3 class="text-white">Quản lý người dùng</h3>
    
    <div class="table-responsive mt-4">
        <table class="table table-dark table-striped table-hover">
            <thead>
                <tr>
                    <th scope="col" class="text-center">#</th>
                    <th scope="col">Tên</th>
                    <th scope="col">Email</th>
                    <th scope="col">Quyền (Role)</th>
                    <th scope="col" class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                {{#each users}}
                <tr>
                    <th scope="row" class="text-center">{{sum @index 1}}</th>
                    <td>{{this.name}}</td>
                    <td>{{this.email}}</td>
                    
                    {{!-- Cột Đổi Role --}}
                    <td>
                        <form action="/admin/change-role/{{this._id}}" method="POST" class="d-flex align-items-center">
                            <select name="role" class="form-control form-control-sm mr-2" style="max-width: 120px;">
                                <option value="user" {{#if (equals this.role "user")}}selected{{/if}}>User</option>
                                <option value="admin" {{#if (equals this.role "admin")}}selected{{/if}}>Admin</option>
                            </select>
                            <button type="submit" class="btn btn-primary btn-sm">Sửa</button>
                        </form>
                    </td>

                    {{!-- Cột Xóa --}}
                    <td class="text-center">
                        <form action="/admin/delete/{{this._id}}?_method=DELETE" method="POST" 
                              onsubmit="return confirm('Bạn có chắc chắn muốn xóa người dùng [{{this.name}}] không?')">
                            <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                        </form>
                    </td>
                </tr>
                {{else}}
                <tr>
                    <td colspan="5" class="text-center">Chưa có người dùng nào trong danh sách.</td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</div>

<style>
    
    .table-dark {
        background-color: #2c3e50;
        border-radius: 8px;
        overflow: hidden;
    }
    .btn-sm {
        padding: 0.25rem 0.75rem;
        font-size: 0.8rem;
    }
    select.form-control-sm {
        height: calc(1.8125rem + 2px);
    }
</style>